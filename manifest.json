{
  "manifest_version": 3,
  "name": "Live Lens",
  "version": "0.4.1",
  "description": "Estatísticas e análise por LLM local (Ollama) da seleção ou de um elemento fixado, em tempo real.",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["http://localhost:11434/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "panel.html" },
  "action": { "default_title": "Live Lens" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
